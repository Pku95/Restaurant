# ==========================================================================
# Ember & Saffron — Apache configuration
# Every directive below is wrapped in <IfModule>, so this file can never
# cause a 500 error on a host that lacks a module.
# ==========================================================================

# Prevent directory listings. If your host allows Override for Options
# (cPanel normally does) you can uncomment the next line.
# Options -Indexes

# Serve everything as UTF-8.
AddDefaultCharset UTF-8

# Never allow the config file to be requested directly.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Compress text responses.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache static assets.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 1 month"
    ExpiresByType image/png   "access plus 1 month"
    ExpiresByType image/webp  "access plus 1 month"
    ExpiresByType text/css    "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
